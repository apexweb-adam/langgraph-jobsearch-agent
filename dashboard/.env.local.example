# Public anon key, safe to ship to the browser. Read access only thanks to RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role lives ONLY in serverless functions. Used by /api/decide to
# update user_decision without exposing write access to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
