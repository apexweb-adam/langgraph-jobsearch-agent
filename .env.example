# Gemini API for scoring + profile parsing
GOOGLE_API_KEY=your-gemini-key

# SMTP for the daily digest. Any provider with an app password works: Gmail, Sendgrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jobs@yourdomain.com
SMTP_PASS=app-password-here
SMTP_FROM=jobs@yourdomain.com

# Where to send the digest
DIGEST_TO=client@example.com

# Storage path (SQLite file)
DB_PATH=./data/jobs.db

# Path to the active profile YAML
PROFILE_PATH=./data/profile.yaml

# How many top jobs per digest
DIGEST_TOP_N=15
