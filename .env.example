# ── Required ─────────────────────────────────────────────────────────────────
# Gemini API for scoring + profile parsing
GOOGLE_API_KEY=your-gemini-key

# Path to the active profile YAML
PROFILE_PATH=./data/profile.yaml

# ── Storage (pick at least one) ──────────────────────────────────────────────
# DASHBOARD MODE (default): write scored jobs to Supabase so the dashboard reads
# them. Service-role key bypasses RLS; the dashboard uses the anon key for reads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local SQLite path used in DIGEST mode and tests
DB_PATH=./data/jobs.db

# ── Apify (for Indeed + JS-rendered ATSes like Paylocity / ADP / iCIMS) ─────
APIFY_TOKEN=

# ── Approval workflow ────────────────────────────────────────────────────────
# "dashboard" (default) -> write to Supabase, no email sent
# "digest"             -> SQLite + daily HTML email digest (legacy mode)
APPROVAL_MODE=dashboard

# Only used when APPROVAL_MODE=digest
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jobs@yourdomain.com
SMTP_PASS=app-password-here
SMTP_FROM=jobs@yourdomain.com
DIGEST_TO=client@example.com
DIGEST_TOP_N=15
DIGEST_MIN_SCORE=60
